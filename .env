# ERP Backend - Environment Variables
# ═══════════════════════════════════════
# این فایل را به .env کپی کنید و مقادیر را تنظیم کنید
# ═══════════════════════════════════════

# Neon PostgreSQL Connection String
# از Neon Console بگیرید
DATABASE_URL=postgresql://neondb_owner:npg_GRw8fMDPHhs0@ep-still-fog-abyh2c0y-pooler.eu-west-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Backend Server Port
PORT=3001

# Admin Password (برای لاگین)
ADMIN_PASSWORD=123456

# ═══════════════════════════════════════
# Frontend Environment Variables
# ═══════════════════════════════════════
# این متغیرها در .env.local فرانت‌اند تنظیم می‌شوند

# Backend API URL (اگر Backend را اجرا می‌کنید)
VITE_API_URL=http://localhost:3001/api

# اگر می‌خواهید فقط از localStorage استفاده کنید (بدون Neon)
# VITE_FORCE_LOCAL=true
